# Crew Forge Backend - Production Environment Variables Template

# Node Environment
NODE_ENV=production
PORT=5000

# MongoDB Atlas Database URI
# Enter your real Atlas connection string from MongoDB Atlas dashboard
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.5bg9uxe.mongodb.net/crewforge?retryWrites=true&w=majority

# JWT Authentication Secret Key (use a secure random string)
JWT_SECRET=your_production_jwt_secret_min_32_characters
JWT_EXPIRES_IN=7d

# Allowed Frontend Client Origin(s) for CORS
# In production, set to your Vercel URL (e.g. https://crew-forge.vercel.app)
# Multiple origins can be separated by commas
CLIENT_URL=https://your-frontend-name.vercel.app
