# Crew Forge - Environment Variables Reference Guide

# ==============================================================================
# FRONTEND CONFIGURATION (For Vercel)
# ==============================================================================
# In Vercel Project Settings -> Environment Variables:
# Enter the URL of your deployed Render backend API
VITE_API_BASE_URL=https://your-backend-name.onrender.com/api

# ==============================================================================
# BACKEND CONFIGURATION (For Render)
# ==============================================================================
# In Render Dashboard -> Web Service -> Environment:
# Enter the following environment variables:
NODE_ENV=production
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.5bg9uxe.mongodb.net/crewforge?retryWrites=true&w=majority
JWT_SECRET=your_production_jwt_secret_min_32_characters
CLIENT_URL=https://your-frontend-name.vercel.app
